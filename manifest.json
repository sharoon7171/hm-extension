{
  "manifest_version": 3,
  "name": "HotMovies Extension",
  "version": "1.0.0",
  "action": {},
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hotmovies.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://video.adultempire.com/*",
    "https://*.googleapis.com/*",
    "https://hotmovies-extension.firebaseapp.com/*",
    "https://hotmovies-extension.web.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://hotmovies-extension.firebaseapp.com/*",
      "https://hotmovies-extension.web.app/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
