rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/favoriteScenes/{sceneId} {
      allow read, list, create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
